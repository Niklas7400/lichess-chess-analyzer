# Pfad zum Python-Interpreter der venv im lichess-chess-analyzer Repo
PYTHON_BIN=/home/niklas/lichess-chess-analyzer/.venv/bin/python

# Pfad zum Analyse-Skript
PYTHON_SCRIPT=/home/niklas/lichess-chess-analyzer/analyze_lichess.py

# Verzeichnis, in dem Analyse-Ergebnisse pro Anfrage abgelegt werden (wird automatisch angelegt)
PYTHON_OUTPUT_DIR=/home/niklas/lichess-chess-analyzer/output

# Wird an den Python-Prozess durchgereicht (analyze_lichess.py liest OPENAI_API_KEY aus der Umgebung)
OPENAI_API_KEY=sk-...

# Optional, Default ist /usr/games/stockfish (apt-Paket, Stockfish 16).
# Stockfish 18 liegt lokal im Projekt (bin/stockfish18) und ist deutlich staerker.
STOCKFISH_PATH=/home/niklas/lichess-chess-analyzer/bin/stockfish18
